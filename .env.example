# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for NFT WordChain
#
# Copy this file to `.env` for local dev (NEVER commit .env). On Vercel,
# set the same names through Project Settings → Environment Variables.
#
# Two prefixes:
#   • VITE_*  — shipped to the browser bundle, safe-ish to expose (anon keys,
#               public URLs). Vite inlines these at build time.
#   • SERVER_* — server-only, available to functions under api/ via process.env.
#               NEVER prefix server secrets with VITE_.
# ─────────────────────────────────────────────────────────────────────────────

# Browser-side ------------------------------------------------------------
# Public origin of the deployed API (defaults to same-origin if blank).
# Leave blank when frontend and backend are on the same Vercel project.
VITE_API_ORIGIN=

# Server-side (for /api functions) ---------------------------------------
# Postgres connection string from Neon / Vercel Postgres. v2 will use this
# for the leaderboard + nonce table.
DATABASE_URL=

# Secret used to sign JWTs after a successful nonce verification.
# Generate one for prod: `openssl rand -base64 48`
JWT_SECRET=

# Default JWT lifetime in seconds.
JWT_TTL_SECONDS=86400

# (Optional) Allow-list of origins for CORS — comma-separated.
# Same-origin (Vercel deployment) needs nothing here.
ALLOWED_ORIGINS=

# GalaChain gateway -------------------------------------------------------
# Network: 'mainnet' or 'testnet'. Controls which gateway default is used.
GALACHAIN_NETWORK=testnet

# Override the gateway URL for each network. Defaults below are the canonical
# public endpoints per galachainbootstrap.replit.app/TOKEN_OPS.md.
# Only set these if the team gives you a different gateway to target.
GALACHAIN_GATEWAY_MAINNET=https://gateway-mainnet.galachain.com/api/asset/token-contract
GALACHAIN_GATEWAY_TESTNET=https://gateway-testnet.galachain.com/api/testnet01/gc-a9b8b472b035c0510508c248d1110d3162b7e5f4-GalaChainToken

# HMAC auth for the gateway (required for write operations on testnet/mainnet).
# Get these from the Gala team. Without them, TransferToken will time out.
GALACHAIN_GATEWAY_API_KEY=
GALACHAIN_GATEWAY_SECRET=

# Treasury wallet (gala form: eth|<EIP55>). REQUIRED for purchases.
# This is the wallet that receives GALA from players.
GAME_TREASURY_ADDRESS=

# Analytics ---------------------------------------------------------------
# Events are always written to the local `analytics_events` Postgres table.
# Set the vars below to ALSO forward events to a SaaS analytics service.
#
# ANALYTICS_PROVIDER: segment | mixpanel | posthog | raw (default: raw)
#   Controls how the payload is shaped for the webhook.
#   • segment  — Segment HTTP API /v1/track (Basic auth with write key)
#   • mixpanel — Mixpanel /track (token in payload)
#   • posthog  — PostHog /capture (api_key in payload)
#   • raw      — Posts our own JSON schema; suitable for any custom endpoint
#
# ANALYTICS_WEBHOOK_URL: the full endpoint URL for the chosen provider.
#   Leave blank to only store events locally (safe default).
#
# ANALYTICS_WRITE_KEY: API / write key for the chosen provider.
#   Segment:  your Source write key
#   Mixpanel: your Project token
#   PostHog:  your project API key
#   Custom:   sent as Bearer token in Authorization header
ANALYTICS_PROVIDER=
ANALYTICS_WEBHOOK_URL=
ANALYTICS_WRITE_KEY=
