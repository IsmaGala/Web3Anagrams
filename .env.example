# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for NFT WordChain
#
# Copy this file to `.env` for local dev (NEVER commit .env). On Vercel,
# set the same names through Project Settings → Environment Variables.
#
# Two prefixes:
#   • VITE_*  — shipped to the browser bundle, safe-ish to expose (anon keys,
#               public URLs). Vite inlines these at build time.
#   • SERVER_* — server-only, available to functions under api/ via process.env.
#               NEVER prefix server secrets with VITE_.
# ─────────────────────────────────────────────────────────────────────────────

# Browser-side ------------------------------------------------------------
# Public origin of the deployed API (defaults to same-origin if blank).
# Leave blank when frontend and backend are on the same Vercel project.
VITE_API_ORIGIN=

# Server-side (for /api functions) ---------------------------------------
# Postgres connection string from Neon / Vercel Postgres. v2 will use this
# for the leaderboard + nonce table.
DATABASE_URL=

# Secret used to sign JWTs after a successful nonce verification.
# Generate one for prod: `openssl rand -base64 48`
JWT_SECRET=

# Default JWT lifetime in seconds.
JWT_TTL_SECONDS=86400

# (Optional) Allow-list of origins for CORS — comma-separated.
# Same-origin (Vercel deployment) needs nothing here.
ALLOWED_ORIGINS=
